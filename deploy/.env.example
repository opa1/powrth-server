# ─── Application ─────────────────────────────────────────────────────────────

NODE_ENV=production

# HTTP port — internal only; Caddy proxies this. Must match compose.yml.
PORT=3001

# TCP port — smart meter connections. Must be open in UFW and OCI VCN security list.
TCP_PORT=8765

# ─── Database ─────────────────────────────────────────────────────────────────

# Shared postgres container on the alpha network. Replace password with the real one.
DATABASE_URL=postgresql://powrth_user:REPLACE_WITH_PASSWORD@postgres:5432/powrth_db

# ─── Redis ────────────────────────────────────────────────────────────────────
# Reserved for future use — not yet consumed by the app.
# Shared redis container on the alpha network.

REDIS_URL=redis://:REPLACE_WITH_PASSWORD@redis:6379
REDIS_KEY_PREFIX=powrth:

# ─── JWT ─────────────────────────────────────────────────────────────────────

# Use: openssl rand -hex 64
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_HEX

# ─── HD Wallet ────────────────────────────────────────────────────────────────
# !! WARNING: Every user wallet is derived from this mnemonic.
# !! Losing it means permanent loss of access to all platform-managed wallets.
# !! Back this up offline in at least two separate secure locations before deploying.
# !! Never commit this value. Never log it. Never send it over any channel.
# Generate with: node -e "const b=require('bip39');console.log(b.generateMnemonic(256))"

MASTER_MNEMONIC=REPLACE_WITH_24_WORD_BIP39_MNEMONIC

# ─── Social Auth ─────────────────────────────────────────────────────────────

# Google — from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID

# Apple — from developer.apple.com → Certificates, Identifiers & Profiles
APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
APPLE_KEY_ID=REPLACE_WITH_APPLE_KEY_ID

# X (Twitter) — from developer.twitter.com → App settings → Keys and tokens
X_CLIENT_ID=REPLACE_WITH_X_CLIENT_ID
X_CLIENT_SECRET=REPLACE_WITH_X_CLIENT_SECRET

# ─── Solana ───────────────────────────────────────────────────────────────────

# mainnet | devnet — controls which RPC URL and USDC mint are used at runtime
NETWORK=devnet

# Solana RPC — provide both; NETWORK selects which is active
SOLANA_RPC_URL_MAINNET=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com

# USDC mint address — provide both; NETWORK selects which is active
# Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_MINT_ADDRESS_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT_ADDRESS_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ─── Helius ───────────────────────────────────────────────────────────────────

# API key — from helius.dev dashboard
HELIUS_API_KEY=REPLACE_WITH_HELIUS_API_KEY

# Webhook secrets — must match exactly the value set when creating each
# webhook in the Helius dashboard. Helius sends this as the Authorization
# header value. Provide both; NETWORK selects which is active.
HELIUS_WEBHOOK_SECRET_MAINNET=REPLACE_WITH_HELIUS_WEBHOOK_SECRET_MAINNET
HELIUS_WEBHOOK_SECRET_DEVNET=REPLACE_WITH_HELIUS_WEBHOOK_SECRET_DEVNET

# Optional: webhook ID whose account-address watchlist is kept in sync as users
# are created/activated/deactivated. Leave unset to skip syncing. This
# deployment only ever uses the one matching NETWORK above.
HELIUS_WEBHOOK_ID_MAINNET=REPLACE_WITH_HELIUS_WEBHOOK_ID_MAINNET
HELIUS_WEBHOOK_ID_DEVNET=REPLACE_WITH_HELIUS_WEBHOOK_ID_DEVNET

# ─── Platform ─────────────────────────────────────────────────────────────────

# Fee taken on every credit load (0.02 = 2%). Stored in PlatformConfig in DB;
# this env var sets the initial default only.
PLATFORM_FEE_RATE=0.02
