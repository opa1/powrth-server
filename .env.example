# Runtime environment: development, production, or test
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/powrth?schema=public

# Secret used to sign short-lived JWT access tokens
JWT_ACCESS_SECRET=change-me-access-secret

# Secret used to sign long-lived JWT refresh tokens
JWT_REFRESH_SECRET=change-me-refresh-secret

# WARNING: This is the HD wallet master seed used to derive every user's wallet.
# If this value is lost or leaked, all derived wallets are lost or compromised. Store it in a secrets manager, never in source control.
MASTER_MNEMONIC=change-me-master-mnemonic

# OAuth client ID for Google sign-in
GOOGLE_CLIENT_ID=change-me-google-client-id

# Apple Developer Team ID used for Sign in with Apple
APPLE_TEAM_ID=change-me-apple-team-id

# Apple Key ID for the Sign in with Apple private key
APPLE_KEY_ID=change-me-apple-key-id

# OAuth client ID for X (Twitter) sign-in
X_CLIENT_ID=change-me-x-client-id

# OAuth client secret for X (Twitter) sign-in
X_CLIENT_SECRET=change-me-x-client-secret

# API key for the Helius Solana RPC/indexing service
HELIUS_API_KEY=change-me-helius-api-key

# Shared secret used to verify incoming Helius webhook signatures.
# Helius sends this value directly as the Authorization header on each webhook
# request — it must exactly match the secret configured for that webhook in
# the Helius dashboard, or every request will be rejected. Provide both;
# NETWORK selects which is active. Each network's webhook needs its own value.
HELIUS_WEBHOOK_SECRET_MAINNET=change-me-helius-webhook-secret-mainnet
HELIUS_WEBHOOK_SECRET_DEVNET=change-me-helius-webhook-secret-devnet

# Optional: the webhook ID (from the Helius dashboard/API) whose account-address
# watchlist this app keeps in sync as users are created/activated/deactivated.
# Leave unset to skip address syncing (a warning is logged, nothing fails).
# Requires a separate webhook per network — see the "Network" field in Helius's
# Configure Webhook dialog. NETWORK selects which one is active.
HELIUS_WEBHOOK_ID_MAINNET=
HELIUS_WEBHOOK_ID_DEVNET=

# mainnet | devnet — controls which RPC URL and USDC mint are used at runtime
NETWORK=devnet

# Solana RPC — provide both; NETWORK selects which is active
SOLANA_RPC_URL_MAINNET=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com

# USDC mint address — provide both; NETWORK selects which is active
# Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_MINT_ADDRESS_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT_ADDRESS_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Platform fee rate taken on transactions, expressed as a decimal (0.02 = 2%)
PLATFORM_FEE_RATE=0.02

# Port the TCP server listens on for smart meter connections.
# This port must be reachable from the meters' cellular/network provider:
# open it in the host firewall (e.g. `sudo ufw allow 8765/tcp`) and, if
# deployed on Oracle Cloud, add an equivalent stateful ingress rule for
# TCP/8765 to the instance's VCN security list, or connections will be
# silently dropped before they ever reach this server.
TCP_PORT=8765

# Postgres container credentials, consumed by docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=powrth
