    "@prisma/client": "^7.0.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.0",
    "axios": "^1.7.0",
    "bip39": "^3.1.0",
    "ed25519-hd-key": "^1.3.0",
    "fastify": "^5.0.0",
    "google-auth-library": "^9.14.0",
    "jsonwebtoken": "^9.0.0",
    "jwks-rsa": "^3.1.0",
