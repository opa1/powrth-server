generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PROVIDER
  CONSUMER
  ADMIN
}

model User {
  id             String   @id @default(uuid())
  googleId       String?  @unique
  appleId        String?  @unique
  xId            String?  @unique
  name           String?
  avatar         String?
  email          String?  @unique
  walletAddress  String   @unique
  walletKeyIndex Int      @unique
  role           Role?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  usdcBalance Decimal @default(0) @db.Decimal(18, 6)

  provider             Provider?
  consumer             Consumer?
  authSessions         AuthSession[]
  relayEventsInitiated RelayEvent[]    @relation("RelayInitiator")
  transactionsLoaded   Transaction[]   @relation("CreditLoader")
  walletDeposits       WalletDeposit[]
}

model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  refreshTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId])
}

// Minimal stubs — extended in Phase 3 and beyond
model Provider {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  businessName   String?
  pricePerKwh    Decimal  @default(0) @db.Decimal(10, 6)
  totalEarned    Decimal  @default(0) @db.Decimal(18, 6)
  totalWithdrawn Decimal  @default(0) @db.Decimal(18, 6)
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meters      Meter[]
  withdrawals Withdrawal[]
}

model Consumer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meters         Meter[]
  energyBalances EnergyBalance[]
}

enum MeterStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum RelayState {
  ON
  OFF
  UNKNOWN
}

enum RelayAction {
  TRIP
  CLOSE
}

enum RelayTrigger {
  BALANCE_DEPLETED_METER
  BALANCE_DEPLETED_SERVER
  TOPUP_RECONNECT
  MANUAL_PROVIDER
  MANUAL_ADMIN
}

enum MeterEventType {
  CONNECTED
  DISCONNECTED
  LOGIN
  HEARTBEAT
  ENERGY_REPORT
  RELAY_COMMAND_SENT
  RELAY_COMMAND_ACK
  RELAY_COMMAND_FAILED
}

model Meter {
  id          String      @id @default(uuid())
  meterAddr   String      @unique // 12-char hex e.g. "202108100034"
  serial      String?     @unique
  imei        String?     @unique
  iccid       String?
  softVer     String?
  // Nullable: a meter reports over TCP and exists in the DB before any provider claims it.
  providerId  String?
  provider    Provider?   @relation(fields: [providerId], references: [id])
  consumerId  String?
  consumer    Consumer?   @relation(fields: [consumerId], references: [id])
  status      MeterStatus @default(UNKNOWN)
  relayState  RelayState  @default(UNKNOWN)
  pricePerKwh Decimal?    @db.Decimal(10, 6) // overrides provider default when set
  lastSeen    DateTime?
  installedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  readings      MeterReading[]
  relayEvents   RelayEvent[]
  meterEvents   MeterEvent[]
  energyBalance EnergyBalance?
  transactions  Transaction[]

  @@index([providerId])
  @@index([consumerId])
}

model MeterReading {
  id           String     @id @default(uuid())
  meterId      String
  meter        Meter      @relation(fields: [meterId], references: [id])
  voltageA     Decimal    @db.Decimal(8, 2)
  currentA     Decimal    @db.Decimal(8, 3)
  activePower  Decimal    @db.Decimal(10, 2) // watts
  totalEnergy  Decimal    @db.Decimal(12, 4) // cumulative kWh from meter
  remainingKwh Decimal    @db.Decimal(12, 4) // balance reported by meter
  relayState   RelayState
  signal       Int
  rawFrame     String? // full hex frame for debugging
  readAt       DateTime   @default(now())

  @@index([meterId])
  @@index([readAt])
}

model RelayEvent {
  id                String       @id @default(uuid())
  meterId           String
  meter             Meter        @relation(fields: [meterId], references: [id])
  action            RelayAction
  trigger           RelayTrigger
  initiatedByUserId String?
  initiatedBy       User?        @relation("RelayInitiator", fields: [initiatedByUserId], references: [id])
  commandSentAt     DateTime     @default(now())
  acknowledgedAt    DateTime?
  success           Boolean      @default(false)
  createdAt         DateTime     @default(now())

  @@index([meterId])
}

model MeterEvent {
  id        String         @id @default(uuid())
  meterId   String
  meter     Meter          @relation(fields: [meterId], references: [id])
  type      MeterEventType
  payload   Json
  createdAt DateTime       @default(now())

  @@index([meterId])
  @@index([createdAt])
}

enum TransactionType {
  CREDIT_LOAD
  PROVIDER_WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

model EnergyBalance {
  id                 String    @id @default(uuid())
  consumerId         String
  consumer           Consumer  @relation(fields: [consumerId], references: [id])
  meterId            String    @unique
  meter              Meter     @relation(fields: [meterId], references: [id])
  kwhBalance         Decimal   @default(0) @db.Decimal(12, 4) // server-tracked remaining kWh
  usdcLoaded         Decimal   @default(0) @db.Decimal(18, 6) // total USDC ever loaded
  kwhConsumed        Decimal   @default(0) @db.Decimal(12, 4) // total kWh consumed (for analytics)
  lastTotalEnergyKwh Decimal?  @db.Decimal(12, 4) // meter's cumulative totalEnergy at last sync, for delta calc
  lastSyncedAt       DateTime? // last time synced from meter reading
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([consumerId, meterId])
}

model Transaction {
  id              String            @id @default(uuid())
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  loadedByUserId  String?
  loadedBy        User?             @relation("CreditLoader", fields: [loadedByUserId], references: [id])
  meterId         String?
  meter           Meter?            @relation(fields: [meterId], references: [id])
  usdcAmount      Decimal           @db.Decimal(18, 6) // gross amount loaded
  platformFee     Decimal           @default(0) @db.Decimal(18, 6)
  platformFeeRate Decimal           @default(0) @db.Decimal(6, 4) // fee rate at time of tx
  providerEarning Decimal           @default(0) @db.Decimal(18, 6)
  kwhAmount       Decimal?          @db.Decimal(12, 4) // kWh credited to consumer
  pricePerKwhUsed Decimal?          @db.Decimal(10, 6) // price locked at time of tx
  solanaSignature String?           @unique // on-chain reference, optional in Phase 5
  note            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([meterId])
  @@index([loadedByUserId])
  @@index([createdAt])
}

model PlatformConfig {
  id                String   @id @default("singleton")
  feeRatePercent    Decimal  @default(0.02) @db.Decimal(6, 4) // 2% default
  minCreditLoadUsdc Decimal  @default(1.00) @db.Decimal(10, 2)
  minWithdrawalUsdc Decimal  @default(5.00) @db.Decimal(10, 2)
  feeWalletAddress  String?
  updatedAt         DateTime @updatedAt
}

enum DepositStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model WalletDeposit {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  walletAddress   String
  usdcAmount      Decimal       @db.Decimal(18, 6)
  solanaSignature String        @unique
  status          DepositStatus @default(PENDING)
  confirmedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([walletAddress])
}

model Withdrawal {
  id              String           @id @default(uuid())
  providerId      String
  provider        Provider         @relation(fields: [providerId], references: [id])
  usdcAmount      Decimal          @db.Decimal(18, 6)
  toWalletAddress String
  solanaSignature String?          @unique
  status          WithdrawalStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([providerId])
}
