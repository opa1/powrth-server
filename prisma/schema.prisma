generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PROVIDER
  CONSUMER
  ADMIN
}

model User {
  id             String   @id @default(uuid())
  googleId       String?  @unique
  appleId        String?  @unique
  xId            String?  @unique
  name           String?
  avatar         String?
  email          String?  @unique
  walletAddress  String   @unique
  walletKeyIndex Int      @unique
  role           Role?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider     Provider?
  consumer     Consumer?
  authSessions AuthSession[]
}

model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  refreshTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId])
}

// Minimal stubs — extended in Phase 3 and beyond
model Provider {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  businessName   String?
  pricePerKwh    Decimal  @default(0) @db.Decimal(10, 6)
  totalEarned    Decimal  @default(0) @db.Decimal(18, 6)
  totalWithdrawn Decimal  @default(0) @db.Decimal(18, 6)
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Consumer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
